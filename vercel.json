{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/admin/crons/expire-clients",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "app/api/client/check/route.ts": {
      "maxDuration": 15
    },
    "app/api/admin/base-exe/route.ts": {
      "maxDuration": 30
    },
    "app/api/download/[clientId]/route.ts": {
      "maxDuration": 30
    }
  }
}
